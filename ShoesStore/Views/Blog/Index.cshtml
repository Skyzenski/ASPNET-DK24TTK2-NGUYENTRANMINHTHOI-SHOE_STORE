*@
<div class="container">
    <h2 class="text-center mb-4">Blog List</h2>

    <div class="row justify-content-center">
        @foreach (var blog in Model.Take(9))
        {
            <div class="col-lg-4 col-md-6 mb-4 d-flex align-items-stretch">
                <div class="card shadow-sm w-100 d-flex flex-column text-center">

                    @* Tag Helper cho hình ảnh *@
                    <img src="~/img/blog/@blog.Anhdaidien"
                         class="card-img-top"
                         style="height: 200px; object-fit: cover;"
                         alt="Blog Image">

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold" style="height: 50px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                            @blog.Theloai
                        </h5>

                        <p class="card-text text-muted" style="height: 80px; overflow: hidden; font-size: 0.9rem;">
                            @{
                                // Loại bỏ thẻ HTML và cắt ngắn nội dung
                                var cleanText = System.Text.RegularExpressions.Regex.Replace(blog.Noidung ?? "", "<.*?>", String.Empty);
                                @(cleanText.Length > 100 ? cleanText.Substring(0, 100) + "..." : cleanText)
                            }
                        </p>

                        <div class="mt-auto pt-2">
                            @* Dùng asp-action và asp-route-id *@
                            <a asp-action="Detail"
                               asp-controller="Blog"
                               asp-route-id="@blog.Mablog"
                               class="btn btn-sm btn-outline-primary px-4">More</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
